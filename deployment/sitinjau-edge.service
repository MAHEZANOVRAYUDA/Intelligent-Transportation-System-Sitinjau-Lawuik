[Unit]
Description=Layanan Edge AI Deteksi Kendaraan Sitinjau Lauik (Hailo-8L)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lppmupi
WorkingDirectory=/home/lppmupi/Intelligent-Transportation-System-Sitinjau-Lawuik
EnvironmentFile=-/home/lppmupi/Intelligent-Transportation-System-Sitinjau-Lawuik/.env
ExecStart=/home/lppmupi/Intelligent-Transportation-System-Sitinjau-Lawuik/venv/bin/python3 main_edge.py --gate B --backend auto --interval 5 --web-stream
Restart=always
RestartSec=10
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
