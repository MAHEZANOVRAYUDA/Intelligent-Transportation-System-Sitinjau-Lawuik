# Alamat Server Pusat Sitinjau Lauik (Laptop atau Cloud VPS)
SERVER_URL=http://192.168.1.15:8000

# Kamera prototype Gerbang A
GATE_A_RTSP_URL=rtsp://user:password@192.168.1.100:8554/Streaming/Channels/101

# Kamera Gerbang B (CCTV Bardi)
GATE_B_RTSP_URL=rtsp://admin:bardisitinjau2026b@172.20.10.3:5543/0488bb6f20704458b61e708c6729f374/live/channel0

# Database
