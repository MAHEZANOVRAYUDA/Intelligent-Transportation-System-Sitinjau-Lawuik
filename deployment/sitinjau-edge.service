[Unit]
Description=Layanan Edge AI Deteksi Kendaraan Sitinjau Lauik (Hailo-8L)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adminpi
WorkingDirectory=/home/adminpi/sitinjau-laut
EnvironmentFile=-/home/adminpi/sitinjau-laut/.env
ExecStart=/home/adminpi/sitinjau-laut/venv/bin/python3 main_edge.py --backend auto --interval 5
Restart=always
RestartSec=10
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
