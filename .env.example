# Salin file ini ke .env dan isi dengan nilai sebenarnya

# Kamera prototype Gerbang A
GATE_A_RTSP_URL=rtsp://user:password@192.168.1.100:8554/Streaming/Channels/101

# Kamera Gerbang B (kosongkan jika belum tersedia)
GATE_B_RTSP_URL=

# Database
DATABASE_URL=sqlite:///./data/sitinjau_laut.db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Detection
DETECTION_ENABLED=true
DETECTION_CONFIDENCE=0.45
DETECTION_DEVICE=cpu
